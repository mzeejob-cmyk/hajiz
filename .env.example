# Public, non-sensitive frontend settings only. Use exactly one reviewed pair:
# staging    -> https://pdnuswmljownjzjzpoop.supabase.co
# production -> https://pbvbhbxqtaafqkwlnlxd.supabase.co
# development/test are explicitly restricted to the Staging project.
VITE_APP_ENV=development
VITE_PUBLIC_SITE_URL=http://localhost:5173

# Server-only Travelport TripServices v11 pre-production settings (never VITE_).
# TRAVELPORT_USERNAME=
# TRAVELPORT_PASSWORD=
# TRAVELPORT_CLIENT_ID=
# TRAVELPORT_CLIENT_SECRET=
# TRAVELPORT_ACCESS_GROUP=

# My Trips and Public Catalog environment-aware browser boundary. The anon key
# is public configuration only; never place a service-role/secret key in VITE_.
VITE_SUPABASE_URL=https://pdnuswmljownjzjzpoop.supabase.co
VITE_SUPABASE_ANON_KEY=

# Product P2 / server-only reviewed project identity. These values must describe
# the same environment as SUPABASE_URL at Edge runtime. Secrets never use VITE_.
# HAJIZ_APP_ENV=staging
# HAJIZ_SUPABASE_URL=https://pdnuswmljownjzjzpoop.supabase.co
# HAJIZ_SUPABASE_SECRET_KEY=

# Provider-neutral Flight Node runtime (server-only; never prefix secrets VITE_).
# NODE_ENV must remain non-production while the only enabled supplier is mock.
# PORT=3000
# HOST=0.0.0.0
# HAJIZ_FLIGHT_HOST_ENABLED=true
# HAJIZ_FLIGHT_SUPPLIER_MODE=mock
# HAJIZ_SUPABASE_URL=
# HAJIZ_SUPABASE_SECRET_KEY=
# HAJIZ_FLIGHT_TOKEN_SECRET=
# HAJIZ_ALLOWED_ORIGINS=http://localhost:3000
